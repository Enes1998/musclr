# musclr mobile — copy to `.env`. On a physical device, localhost can't reach your dev machine:
# set this to your computer's LAN IP (find it with `ipconfig` / `ifconfig`), e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:8787
EXPO_PUBLIC_API_URL=http://localhost:8787

# Accounts + multi-device sync (Supabase). See docs/CREDENTIALS.md §3.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Monitoring / analytics (optional; no-op when unset). See docs/CREDENTIALS.md §5.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
