# ── AI provider ───────────────────────────────────────────────────────────────
# "local"  → LM Studio running at localhost:1234 (default)
# "gemini" → Google AI Studio cloud API
AI_PROVIDER=local

# ── Google Gemini (AI_PROVIDER=gemini) ────────────────────────────────────────
# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=
# Model to use — gemma-3-4b-it, gemini-2.0-flash, gemini-1.5-pro, etc.
GEMINI_MODEL=gemma-3-4b-it

# ── LM Studio (AI_PROVIDER=local) ─────────────────────────────────────────────
# Must match the model identifier shown in LM Studio's local server tab
LM_MODEL=local-model

# ── Server port (default: 3001) ───────────────────────────────────────────────
# PORT=3001
