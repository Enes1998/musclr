# ── AI provider ───────────────────────────────────────────────────────────────
# "local"  → LM Studio running at localhost:1234 (default)
# "gemini" → Vertex AI (uses Application Default Credentials)
AI_PROVIDER=local

# ── Google Gemini via Vertex AI (AI_PROVIDER=gemini) ──────────────────────────
# Run once: gcloud auth application-default login --project YOUR_PROJECT_ID
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# ── LM Studio (AI_PROVIDER=local) ─────────────────────────────────────────────
# Must match the model identifier shown in LM Studio's local server tab
LM_MODEL=local-model

# ── Server port (default: 3001) ───────────────────────────────────────────────
# PORT=3001
