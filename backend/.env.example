# musclr backend — copy to `.env` and fill in. Everything works with NO config (mock AI + USDA
# DEMO_KEY); fill these in to enable live features. See docs/CREDENTIALS.md for where to get each.

# --- Server ---
PORT=8787
# Comma-separated allow-list in production, e.g. https://app.musclr.com,https://musclr.com
ALLOWED_ORIGINS=*

# --- Nutrition data ---
# Free USDA key: https://fdc.nal.usda.gov/api-key-signup.html  (DEMO_KEY is rate-limited)
USDA_API_KEY=DEMO_KEY
# Open Food Facts requires a descriptive UA with contact info.
OFF_USER_AGENT=musclr/0.1 (you@example.com)

# --- Hosted AI coach (default provider): Google Vertex AI via Application Default Credentials ---
# `gcloud auth application-default login` locally; service account on Cloud Run.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1

# --- Optional model overrides (defaults are sensible; model IDs churn — set what you have access to) ---
# HOSTED_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-2024-08-06
# ANTHROPIC_MODEL=claude-sonnet-4-6
# GOOGLE_MODEL=gemini-2.5-flash
# LOCAL_MODEL=llama3.1
# LOCAL_BASE_URL=http://localhost:11434/v1

# --- Anti-abuse on the LLM routes (all optional; enforced only when set) ---
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_PER_DAY=500
# Require a valid Supabase JWT (anonymous sign-in counts) on the hosted relay.
REQUIRE_AUTH=false
# Supabase project URL (enables JWKS verification) and/or legacy HS256 JWT secret.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Cloudflare Turnstile secret (web bot defense).
TURNSTILE_SECRET=

# --- Wearables / health cloud OAuth (Phase 7; see docs/WEARABLES.md). All optional. ---
# Public URL of THIS backend, used to build OAuth redirect URIs.
PUBLIC_BASE_URL=http://localhost:8787
# Per-provider OAuth app credentials (register each app first).
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
# Google Cloud KMS key for envelope-encrypting stored provider tokens (optional, prod).
KMS_KEY_NAME=
# Master secret for AES-256-GCM encryption of wearable OAuth tokens at rest (keep in Secret Manager).
HEALTH_TOKEN_MASTER_KEY=
